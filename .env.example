# Dormify — Environment Variable Template
#
# Copy this file to `.env` (repo root — NOT inside backend/, see
# backend/README.md) and fill in real local values. `.env` itself is
# git-ignored and never committed. Every value below is a placeholder —
# do not copy real secrets into this file.
#
# For the full audit this file is based on, see ENV_CONFIGURATION_AUDIT.md
# and ENV_EXAMPLE_PRECHECK.md.

# ============================================================
# Django / local development
# ============================================================

# LOCAL DEVELOPMENT ONLY. Must NOT be used in production — leaving this
# unset defaults to False (secure by default; see settings.py).
DEBUG=True

# Django's cryptographic signing key. The placeholder below only works
# while DEBUG=True (settings.py falls back to a fixed, clearly-labeled
# dev-only key in that case). Outside local development, replace this
# with a real, strong, unique secret — the app refuses to start without
# one once DEBUG=False.
SECRET_KEY=your-secret-key-here

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================
# PostgreSQL
# ============================================================

DB_NAME=dormify
DB_USER=your-db-user-here
DB_PASSWORD=your-password-here
DB_HOST=localhost
DB_PORT=5432

# Code defaults to "require" if this is left unset (see settings.py). A
# remote/managed PostgreSQL host may require TLS, but a local PostgreSQL
# install's SSL configuration varies — pick the mode that matches your
# own setup rather than assuming one universally works.
# DB_SSLMODE=disable

# ============================================================
# CORS
# ============================================================

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================
# Seed script (backend/seed.py) — optional, development only
# ============================================================

# Optional. If left unset, seed.py generates a random password per run and
# prints it once to the console instead. Only meaningful when DEBUG=True
# (seed.py refuses to run otherwise).
SEED_ADMIN_PASSWORD=your-password-here
SEED_STAFF_PASSWORD=your-password-here

# ============================================================
# Frontend API configuration
# ============================================================
# Current code actively uses BOTH of the variables below, from two
# separate frontend HTTP clients with two different expected URL formats.
# This is a known existing inconsistency (see ENV_EXAMPLE_PRECHECK.md) and
# is documented accurately here rather than silently changed.

# Used by src/services/api.js (nearly all pages). Must NOT include /api —
# that client adds /api/... itself on every call.
REACT_APP_API_BASE=http://localhost:8000

# Used by src/services/usersApi.js (UsersPage only). DOES include /api,
# unlike REACT_APP_API_BASE above.
REACT_APP_API_URL=http://localhost:8000/api

# ============================================================
# Optional advanced variables (safe defaults already in code)
# ============================================================

# DRF throttle rates for auth-sensitive endpoints
# THROTTLE_AUTH_LOGIN=10/min
# THROTTLE_AUTH_SENSITIVE=10/min
# THROTTLE_STAFF_CREATE=20/min
# THROTTLE_AUTH_REFRESH=30/min
# THROTTLE_AUTH_LOGOUT=30/min

# JWT access/refresh token lifetimes (minutes) and refresh-cookie settings
# JWT_ACCESS_TOKEN_LIFETIME=20
# JWT_REFRESH_TOKEN_LIFETIME=10080
# JWT_REFRESH_COOKIE_NAME=dormify_refresh
# JWT_REFRESH_COOKIE_PATH=/api/auth/
# JWT_REFRESH_COOKIE_SAMESITE=Lax
# JWT_REFRESH_COOKIE_SECURE=False
# JWT_REFRESH_COOKIE_DOMAIN=

# Allocation solver / upload limits
# ALLOCATION_NUM_SEARCH_WORKERS=2
# MAX_UPLOAD_FILE_SIZE_MB=25

# Production hardening (only take effect when DEBUG=False)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# DJANGO_BEHIND_HTTPS_PROXY=False
